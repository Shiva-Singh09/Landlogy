# LANDLOGY — backend API configuration (copy to .env and fill real values)
# Values here are PLACEHOLDERS. Never commit real SMTP credentials.

# Port the API server listens on
PORT=5000

# Comma-separated list of allowed frontend origins (e.g. http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# ── SMTP (email sending) ─────────────────────────────────────────────
# Use your real provider hostname e.g. smtp.gmail.com (Gmail), smtp.zoho.in, smtp.office365.com etc.
# Gmail: use smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false and an APP PASSWORD:
#   enable 2-Step Verification on the Google account, then create an app password at
#   https://myaccount.google.com/apppasswords and use it as SMTP_PASS (16-char, spaces optional).
# Do NOT leave smtp.example.com — email will fail to connect.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
# true for SSL/TLS (usually 465), false for STARTTLS (usually 587)
SMTP_SECURE=false
# Most providers require the FULL email address as username (e.g. you@gmail.com)
SMTP_USER=your-smtp-username-or-full-email
# Your SMTP password or app-password (server-only; never expose to frontend/public files)
SMTP_PASS=your-smtp-password-or-app-password

# Where website enquiries/contact messages are delivered
MAIL_TO=client@example.com
# Optional" defaults to SMTP_USER. Must be an address your SMTP account is allowed to send from (provider-verified sender,)
MAIL_FROM=your-smtp-username-or-full-email
