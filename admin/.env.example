# LANDLOGY Admin — frontend environment (copy to `.env` and adjust)
# Base URL of the LANDLOGY backend API, without a trailing slash.
# Must be prefixed with VITE_ so Vite exposes it to the client.
# Local default matches the backend's default PORT (see backend/.env.example).
# Vercel production MUST set VITE_API_BASE_URL to the deployed Render backend URL.
VITE_API_BASE_URL=http://localhost:5000
# VITE_API_URL is accepted as a legacy alias; prefer VITE_API_BASE_URL.
