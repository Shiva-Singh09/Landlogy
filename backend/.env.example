# LANDLOGY — backend API configuration (copy to .env and fill real values)
# Values here are PLACEHOLDERS. Never commit real API keys or credentials.

# Port the API server listens on
PORT=5000

# Comma-separated list of allowed frontend origins (e.g. http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# ── PostgreSQL ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=landlogy
DB_USER=postgres
DB_PASSWORD=
# Set to true in production for SSL connections
DB_SSL=false

# ── Connection pool (optional, env-driven tuning) ───────────────────
# Defaults shown below. Keep DB_POOL_MIN >= 1 so at least one warm
# connection is always ready (each remote DB round trip is expensive).
# Raise DB_POOL_MAX only if you need more concurrent requests than the
# database/provider connection limit allows.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=30000
DB_POOL_EVICT=10000

# ── Authentication ──────────────────────────────────────────────
# JWT secret for signing authentication tokens. CHANGE THIS in production.
JWT_SECRET=change-this-to-a-random-secret-in-production

# ── Rate Limiting (general /api limiter, per IP) ─────────────────────
# General API rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40

# ── File Uploads ────────────────────────────────────────────────
# Directory for storing uploaded files (relative to backend root)
UPLOAD_DIR=uploads
# Maximum upload file size in bytes (default: 5MB = 5242880)
MAX_UPLOAD_SIZE=5242880

# ── Initial Admin Bootstrap (one-time setup only) ───────────────────
# Used only by: npm run db:create-admin
# These variables are NOT used by the running server.
# Supply them only during initial setup, then remove from environment.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=LANDLOGY Admin

# ── Brevo (transactional email sending) ──────────────────────────────
# Server-only. Never expose BREVO_API_KEY to the frontend / Vercel env.
# Get the key from: Brevo dashboard → Settings → SMTP & API → API Keys.
BREVO_API_KEY=

# Where website enquiries/contact messages are delivered
MAIL_TO=client@example.com
# Must be a verified Brevo sender address (Brevo dashboard → Settings → Senders & IP)
MAIL_FROM=verified-sender@example.com
